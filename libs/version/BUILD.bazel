load("@rules_python//python:defs.bzl", "py_library")

# Code generation inside the build graph:
#   release/version.txt  ->  version.py  ->  //libs/greeter  ->  services  ->  images
#
# Because the generated file is a real Bazel action, editing version.txt
# invalidates exactly the targets downstream of it and nothing else. This is
# the cheapest demo of "build-graph health": run
#   bazel query 'rdeps(//..., //release:version.txt)'
# to see the exact blast radius of a version bump.
genrule(
    name = "gen_version",
    srcs = ["//release:version.txt"],
    outs = ["version.py"],
    cmd = 'printf \'"""Generated by //libs/version:gen_version - do not edit."""\\nVERSION = "%s"\\n\' "$$(cat $<)" > $@',
)

py_library(
    name = "version",
    srcs = [
        "__init__.py",
        "version.py",  # generated above
    ],
    visibility = ["//visibility:public"],
    deps = ["//libs:libs_pkg"],
)
